# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Ignore Android generated resource value files (locales, alternate configs)
**/android/**/res/values-*.xml
**/apps/**/android/**/res/values-*.xml

# Ignore Android generated directories often created by build or tooling
**/android/**/res/values-*/

# Flutter generated
.flutter-plugins
.flutter-plugins-dependencies

# Flutter & platform build outputs
**/build/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/.gradle/
**/.idea/

# Ignore duplicate files with a ' 2' suffix (export/IDE duplicates)
# match any filename that contains space+2 before the extension
**/*\ 2.*
**/*\ 2.*
# also match files with ' 2' anywhere
**/* 2.*

# Flutter launcher icons (generated files)
**/android/app/src/main/res/**/ic_launcher_foreground.png
**/android/app/src/main/res/**/ic_launcher_background.png
**/android/app/src/main/res/**/ic_launcher.png
**/android/app/src/main/res/**/ic_launcher.xml
**/ios/**/Icon-App-*.png
**/macos/**/app_icon_*.png
ic_launcher.xml
colors.xml

# iOS project files (Xcode generated)
**/ios/**/*.pbxproj
**/macos/**/*.pbxproj

# IntelliJ IDEA files
**/*.iml
.idea/
